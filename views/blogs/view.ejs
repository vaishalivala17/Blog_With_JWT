<%- include('../partials/header') %>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="card shadow-lg">
                    <% if (blog.image) { %>
                        <img src="<%= blog.image %>" class="card-img-top" alt="Blog Image" style="max-height: 400px; object-fit: cover;">
                    <% } %>
                    <div class="card-body p-5">
                        <h1 class="display-4 mb-4"><%= blog.title %></h1>
                        
                        <div class="d-flex align-items-center mb-4">
                            <div class="author-avatar me-3">
                                <%= blog.author.username.charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <strong><%= blog.author.username %></strong>
                                <br>
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i><%= new Date(blog.createdAt).toLocaleDateString() %>
                                    <% if (blog.updatedAt > blog.createdAt) { %>
                                        <span class="ms-2">(Updated: <%= new Date(blog.updatedAt).toLocaleDateString() %>)</span>
                                    <% } %>
                                </small>
                            </div>
                        </div>
                        
                        <% if (blog.video) { %>
                            <div class="mb-4">
                                <div class="video-container">
                                    <% if (blog.video.includes('youtube') || blog.video.includes('youtu.be')) { %>
                                        <% 
                                            let videoId = '';
                                            if (blog.video.includes('youtu.be/')) {
                                                videoId = blog.video.split('youtu.be/')[1];
                                            } else if (blog.video.includes('v=')) {
                                                videoId = blog.video.split('v=')[1];
                                            }
                                        %>
                                        <iframe width="100%" height="400" src="https://www.youtube.com/embed/<%= videoId %>" frameborder="0" allowfullscreen></iframe>
                                    <% } else if (blog.video.includes('vimeo')) { %>
                                        <% let videoId = blog.video.split('vimeo.com/')[1]; %>
                                        <iframe width="100%" height="400" src="https://player.vimeo.com/video/<%= videoId %>" frameborder="0" allowfullscreen></iframe>
                                    <% } else { %>
                                        <video width="100%" controls>
                                            <source src="<%= blog.video %>" type="video/mp4">
                                            Your browser does not support the video tag.
                                        </video>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                        
                        <div class="blog-content" style="font-size: 1.1rem; line-height: 1.8;">
                            <%= blog.content %>
                        </div>
                        
                        <hr class="my-4">
                        
                        <div class="d-flex gap-3">
                            <a href="/blogs" class="btn btn-primary">
                                <i class="fas fa-arrow-left me-2"></i>Back to Blogs
                            </a>
                            <% if (typeof userId !== 'undefined' && userId && blog.author._id.toString() === userId) { %>
                                <a href="/blogs/edit/<%= blog._id %>" class="btn btn-warning">
                                    <i class="fas fa-edit me-2"></i>Edit
                                </a>
                                <form action="/blogs/delete/<%= blog._id %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this blog?')">
                                        <i class="fas fa-trash me-2"></i>Delete
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<%- include('../partials/footer') %>
