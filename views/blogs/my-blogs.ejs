<%- include('../partials/header') %>

    <div class="page-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-4 fw-bold">My Blogs</h1>
                    <p class="lead">Manage your personal blog collection</p>
                </div>
                <a href="/blogs/create" class="btn btn-light btn-lg">
                    <i class="fas fa-plus me-2"></i>Create New Blog
                </a>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <% if (blogs.length > 0) { %>
            <div class="row g-4">
                <% blogs.forEach(blog => { %>
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100">
                            <% if (blog.image) { %>
                                <img src="<%= blog.image %>" class="card-img-top" alt="Blog Image" style="height: 200px; object-fit: cover;">
                            <% } else { %>
                                <img src="https://images.unsplash.com/photo-1499750310107-5fef28a66643?w=400&h=250&fit=crop" class="card-img-top" alt="Default Blog Image" style="height: 200px; object-fit: cover;">
                            <% } %>
                            <div class="card-body">
                                <h5 class="card-title"><%= blog.title %></h5>
                                <p class="card-text text-muted"><%= blog.content.substring(0, 100) %>...</p>
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i><%= new Date(blog.createdAt).toLocaleDateString() %>
                                </small>
                            </div>
                            <div class="card-footer bg-transparent">
                                <div class="d-flex gap-2">
                                    <a href="/blogs/view/<%= blog._id %>" class="btn btn-info btn-sm flex-grow-1">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    <a href="/blogs/edit/<%= blog._id %>" class="btn btn-warning btn-sm flex-grow-1">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <form action="/blogs/delete/<%= blog._id %>" method="POST" class="d-inline flex-grow-1">
                                        <button type="submit" class="btn btn-danger btn-sm w-100" onclick="return confirm('Are you sure you want to delete this blog?')">
                                            <i class="fas fa-trash"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="fas fa-book-open fa-4x text-muted mb-4"></i>
                <h3>You haven't created any blogs yet</h3>
                <p class="text-muted">Start sharing your thoughts with the world!</p>
                <a href="/blogs/create" class="btn btn-primary mt-2">Create Your First Blog</a>
            </div>
        <% } %>
    </div>

<%- include('../partials/footer') %>
